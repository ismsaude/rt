{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "//": "SPA: qualquer rota cai no index.html. Necessário para quando a navegação passar a usar URL (react-router).",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "//": "Sistema com prontuário: nunca deve aparecer em busca.",
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "//": "Impede que o sistema seja embutido em iframe de outro site (clickjacking).",
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "//": "Bloqueia acesso a câmera, microfone e localização.",
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "//": "Assets do Vite têm hash no nome: podem ser cacheados para sempre.",
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
