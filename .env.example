# Copie para .env e preencha com as credenciais do projeto Supabase.
# NUNCA versione o .env preenchido.

# Conexão direta com o Postgres — usada pelo Prisma para aplicar as
# migrações de supabase/migrations/. Use a porta 5432 (conexão direta),
# que aceita DDL; a 6543 é o pooler e pode recusar.
DATABASE_URL=

# Credenciais do frontend (também precisam existir em frontend/.env).
# A chave anônima é PÚBLICA: vai no bundle JavaScript e qualquer pessoa
# pode lê-la. A proteção real dos dados depende das políticas de RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
